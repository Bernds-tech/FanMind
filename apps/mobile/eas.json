{
  "cli": {
    "version": ">= 19.1.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.13.1",
      "android": {
        "buildType": "apk"
      }
    },
    "native-validation": {
      "extends": "development",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.13.1",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "node": "22.13.1",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
